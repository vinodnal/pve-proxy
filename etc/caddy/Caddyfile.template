{
    admin localhost:2019
    email {{ email }}
{% if acme_ca %}    acme_ca {{ acme_ca }}
{% endif %}
}

*.{{ domain }} {
    tls {
        dns cloudflare {env.CLOUDFLARE_API_TOKEN}
    }

    # Trusted clients: Tailscale CGNAT (100.64.0.0/10) plus any extra subnets
    # configured via config.sh -> Advanced -> trusted subnets. Everything else
    # is rejected at the Caddy layer (defense in depth behind the tailnet ACL).
    @not-trusted not remote_ip {{ allowed_cidrs | default("100.64.0.0/10") }}
    respond @not-trusted 403

    # ---- BEGIN GENERATED BLOCKS (managed by pve-proxy-sync, do not hand-edit) ----
{% for svc in services %}
    @{{ svc.name }} host {{ svc.name }}.{{ domain }}
    handle @{{ svc.name }} {
{% if svc.auth == "basic" %}
        basicauth {
            admin {{ svc.basic_auth_hash }}
        }
{% endif %}
        reverse_proxy {{ svc.ip }}:{{ svc.port }}
    }
{% endfor %}
    # ---- END GENERATED BLOCKS ----

    handle {
        respond "not found" 404
    }
}
